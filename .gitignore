# personal reference captures, handoffs and unrelated local work
/docs/design/reference/*.png
/prompt.txt
/sample.txt
/workspace/

# audit round 2 screenshots (large, regenerable)
/audit/r2/shots/

# trailer footage (tools/trailer.py), large and made again at will
/examplevideos/

# working notes for handing work between sessions (see todo.md)
/todo.md

# the published Android app: each server builds its own (make build, tools/android_release.py)
/downloads/android/*.apk
/downloads/android/manifest.json
