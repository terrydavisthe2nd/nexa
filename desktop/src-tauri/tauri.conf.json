{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexa",
  "version": "2.0.0",
  "identifier": "xyz.evilion.chat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "desktop"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "shortDescription": "Nexa for your computer",
    "longDescription": "The Nexa desktop app: end-to-end encrypted chat, calls and Rich Presence in one small window.",
    "copyright": "Copyright \u00a9 2026 terrydavisthe2nd / Nexa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
